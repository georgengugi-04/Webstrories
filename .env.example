# Copy this file to .env in the project root before running
# `docker compose up`. Docker Compose reads .env automatically.

# ---------------------------------------------------------------
# Database (MySQL container)
# ---------------------------------------------------------------
MYSQL_DATABASE=greentrack
MYSQL_USER=greentrack
MYSQL_PASSWORD=change-me-to-a-real-password
MYSQL_ROOT_PASSWORD=change-me-too-a-different-real-password

# ---------------------------------------------------------------
# Backend
# ---------------------------------------------------------------
# Comma-separated list of origins allowed to call the API. In production,
# set this to your real frontend URL(s) — never leave it as "*".
ALLOWED_ORIGINS=http://localhost:8080

# WhatsApp Cloud API — see backend/README.md for how to get these.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_NUMBER=2547XXXXXXXX

# GitHub webhook signing secret — any random string, must match what you
# set in the repo's Webhook settings on GitHub.
GITHUB_WEBHOOK_SECRET=

# Notion integration — see backend/README.md.
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_TITLE_PROPERTY=Name

# ---------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------
# The URL the BROWSER will use to reach the backend. For local
# docker-compose this is fine as-is; for a real deployment, set this to
# your public backend URL, e.g. https://api.greentrack.africa
FRONTEND_API_BASE_URL=http://localhost:4000

# ---------------------------------------------------------------
# Docker Hub (only needed if you're publishing/pulling images —
# see "Sharing your images" in DOCKER.md)
# ---------------------------------------------------------------
DOCKERHUB_USERNAME=yourusername

# ---------------------------------------------------------------
# Host port mapping (optional — these defaults are usually fine)
# ---------------------------------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=4000
